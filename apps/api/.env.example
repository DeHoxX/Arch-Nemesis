# Environment configuration template for Arch-Nemesis API
# NEVER put real secrets, keys, or passwords in this file. Copy this file to .env for local configuration.
GEMINI_API_KEY=
LLM_MODEL_INTAKE=
LLM_MODEL_ARCHITECT=
LLM_MODEL_WRITER=
LLM_MODEL_MODELS=
LLM_MODEL_ADVISOR=
DATABASE_URL=sqlite+aiosqlite:///./arch_nemesis.db
ADMIN_TOKEN=
LOG_LEVEL=INFO
# ARCHITECT_PROMPT_NAME=architect_v10  # default: architect_v10 (architect_v8 selectable via override)
# ARCHITECT_REPAIR_PROMPT_NAME=architect_repair_v10  # default: architect_repair_v10 (architect_repair_v8 selectable via override)
HF_TOKEN=
HF_PROXY_RATE_LIMIT_REQUESTS=30
HF_PROXY_RATE_LIMIT_WINDOW_SECONDS=60.0
ADVISOR_RATE_LIMIT_REQUESTS=4
ADVISOR_RATE_LIMIT_WINDOW_SECONDS=60.0

