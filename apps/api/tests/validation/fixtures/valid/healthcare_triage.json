{
  "nodes": [
    {
      "id": "symptom_form",
      "name": "Patient Intake Form",
      "type": "web_intake",
      "role": "Captures patient symptoms, vital signs, and onset timeline",
      "inputs": ["patient_inputs"],
      "outputs": ["symptom_payload"],
      "needs_model": false
    },
    {
      "id": "vitals_checker",
      "name": "Vitals Boundary Checker",
      "type": "validator",
      "role": "Checks critical heart rate, SpO2, and blood pressure ranges",
      "inputs": ["symptom_payload"],
      "outputs": ["checked_vitals"],
      "needs_model": false
    },
    {
      "id": "triage_ai",
      "name": "Clinical Triage Model",
      "type": "medical_ai",
      "role": "Assesses acuity level: emergency, urgent, or routine",
      "inputs": ["checked_vitals"],
      "outputs": ["triage_score"],
      "needs_model": true
    },
    {
      "id": "queue_router",
      "name": "Department Queue Router",
      "type": "dispatcher",
      "role": "Routes patient to ER, urgent care, or telemedicine schedule",
      "inputs": ["triage_score"],
      "outputs": ["queue_ticket"],
      "needs_model": false
    }
  ],
  "edges": [
    {"from": "symptom_form", "to": "vitals_checker", "flows": "unverified patient vitals"},
    {"from": "vitals_checker", "to": "triage_ai", "flows": "validated vital signs"},
    {"from": "triage_ai", "to": "queue_router", "flows": "acuity score and recommendation"}
  ],
  "constraints": [
    {
      "id": "c_precede_vitals",
      "text": "Vitals checker must precede clinical triage model",
      "kind": "must_precede",
      "a": "vitals_checker",
      "b": "triage_ai",
      "covers": ["bc_vitals_safety"]
    },
    {
      "id": "c_pass_triage",
      "text": "All patient queues must pass through Clinical Triage Model",
      "kind": "must_pass_through",
      "node_id": "triage_ai",
      "covers": ["bc_triage_audit"]
    }
  ],
  "entry_ids": ["symptom_form"],
  "exit_ids": ["queue_router"]
}

